<!DOCTYPE html>
<html lang="de" class="<%= darkMode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Portfolio von Jamie Achatz</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicons/android-chrome-512x512.png">
    <link rel="icon" type="image/x-icon" href="/favicons/favicon.ico">
    <link rel="manifest" href="/favicons/site.webmanifest">
</head>
<body>
    <button id="darkModeBtn" class="darkmodebtn"><%= darkMode === 'dark' ? '☀️ Light Mode' : '🌙 Dark Mode' %></button>
    <h1 class="title">Portofolio von Jamie Achatz</h1>
    <p class="welcome">Hallo, ich bin Jamie Achatz und ich mache gerne Web und Android Apps.</p>
    <h1 class="langstitle">Hier sind Technologien mit denen ich gearbeitet habe aufgelistet.</h1>
    <div class="langscontainer">
        <div class="langs">
            <div class="java">
                <div class="javapicdiv">
                    <img class="javapic langpic" src="/images/java.png" alt="Java Logo">
                </div>
                <h2 class="javatxt langstxt">Java</h2>
            </div>
            <div class="html">
                <div class="htmlpicdiv">
                    <img class="htmlpic langpic" src="/images/html.png" alt="HTML Logo">
                </div>
                <h2 class="htmltxt langstxt">HTML 5</h2>
            </div>
            <div class="cs">
                <div class="cspicdiv">
                    <img class="cspic langpic" src="/images/cs.png" alt="C# Logo">
                </div>
                <h2 class="cstxt langstxt">C#</h2>
            </div>
            <div class="css">
                <div class="csspicdiv">
                    <img class="csspic langpic" src="/images/css.png" alt="CSS Logo">
                </div>
                <h2 class="csstxt langstxt">CSS</h2>
            </div>
        </div>
        <div class="langs">
            <div class="gh">
                <div class="ghpicdiv">
                    <img class="ghpic langpic" src="/images/gh.png" alt="GitHub Logo">
                </div>
                <h2 class="ghtxt langstxt">GitHub</h2>
            </div>
            <div class="git">
                <div class="gitpicdiv">
                    <img class="gitpic langpic" src="/images/git.png" alt="Git Logo">
                </div>
                <h2 class="gittxt langstxt">Git</h2>
            </div>
            <div class="gitlab">
                <div class="gitlabpicdiv">
                    <img class="gitlabpic langpic" src="/images/gitlab.png" alt="GitLab Logo">
                </div>
                <h2 class="gitlabtxt langstxt">GitLab</h2>
            </div>
            <div class="kt">
                <div class="ktpicdiv">
                    <img class="ktpic langpic" src="/images/kt.png" alt="Kotlin Logo">
                </div>
                <h2 class="kttxt langstxt">Kotlin</h2>
            </div>
            <div class="linux">
                <div class="linuxpicdiv">
                    <img class="linuxpic langpic" src="/images/linux.png" alt="Linux Logo">
                </div>
                <h2 class="linuxtxt langstxt">Linux</h2>
            </div>
        </div>
    </div>
    <h1 class="projectstitle">Hier sind Projekte die ich gemacht habe aufgelistet.</h1>
    <div class="projectscontainer">
        <div class="projects">
            <div class="geoweather">
                <div class="geoweatherpicdiv">
                    <a href="/geoweather">
                        <img class="geoweatherpic" src="/images/geoweather.png" alt="GeoWeather Logo">
                    </a>
                </div>
                <h2 class="geoweathertxt projectstxt">GeoWeather</h2>
            </div>
            <div class="ssmpc">
                <div class="ssmpcpicdiv">
                    <a href="/ssmpc">
                        <img class="ssmpcpic" src="/images/ssmpc.png" alt="SuperSMP Companion Logo">
                    </a>
                </div>
                <h2 class="ssmpctxt projectstxt">SuperSMP Companion</h2>
            </div>
        </div>
    </div>

    <script>
        const button = document.getElementById("darkModeBtn");
        const html = document.documentElement;

        button.addEventListener("click", () => {
            fetch('/api/toggle-darkmode', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.darkMode === 'true') {
                        html.classList.remove("light");
                        html.classList.add("dark");
                        button.textContent = "☀️ Light Mode";
                    } else {
                        html.classList.remove("dark");
                        html.classList.add("light");
                        button.textContent = "🌙 Dark Mode";
                    }
                });
        });
    </script>
</body>
</html>
